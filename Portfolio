<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stephen Raj R S · Performance Marketing Portfolio</title>
  
  <!-- Fonts matching the editorial design -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #0c0e12;
      --surface: #14171f;
      --surface-card: #191d27;
      --border: #262b3a;
      --border-accent: #3b4256;
      --text-primary: #f1f3f7;
      --text-secondary: #9aa1b2;
      --text-muted: #656c7d;
      --accent-gold: #e5b869;
      --accent-blue: #4f8cff;
      --accent-teal: #2dd4bf;
      --accent-badge-bg: rgba(229, 184, 105, 0.12);
      --accent-blue-bg: rgba(79, 140, 255, 0.12);
      --font-body: 'Plus Jakarta Sans', sans-serif;
      --font-serif: 'Instrument Serif', Georgia, serif;
      --font-mono: 'Space Grotesk', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg);
      color: var(--text-primary);
      font-family: var(--font-body);
      line-height: 1.65;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Fixed Clean Minimal Navbar */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      background: rgba(12, 14, 18, 0.85);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav-brand {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.05em;
      color: var(--text-primary);
      text-transform: uppercase;
    }

    .nav-brand span {
      color: var(--accent-gold);
    }

    nav ul {
      display: flex;
      gap: 1.8rem;
      list-style: none;
    }

    nav a {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      transition: color 0.2s ease;
    }

    nav a:hover {
      color: var(--accent-gold);
    }

    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Hero Section */
    .hero {
      padding: 9rem 0 5rem;
      position: relative;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      background: var(--accent-badge-bg);
      border: 1px solid rgba(229, 184, 105, 0.3);
      color: var(--accent-gold);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }

    .hero h1 {
      font-family: var(--font-serif);
      font-size: clamp(3rem, 6.5vw, 5.2rem);
      font-weight: 400;
      line-height: 1.08;
      letter-spacing: -0.01em;
      margin-bottom: 1.25rem;
    }

    .hero h1 em {
      font-style: italic;
      color: var(--accent-gold);
    }

    .hero-subtitle {
      font-size: clamp(1.05rem, 1.8vw, 1.25rem);
      color: var(--text-secondary);
      max-width: 820px;
      margin-bottom: 2rem;
      font-weight: 400;
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 3.5rem;
    }

    .tag {
      padding: 0.35rem 0.85rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.82rem;
      color: var(--text-secondary);
      font-weight: 500;
    }

    /* Metric Counters Banner */
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.25rem;
      border-top: 1px solid var(--border);
      padding-top: 2.5rem;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 1.5rem;
      border-radius: 10px;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .stat-card:hover {
      transform: translateY(-3px);
      border-color: var(--accent-gold);
    }

    .stat-number {
      font-family: var(--font-mono);
      font-size: 2.2rem;
      font-weight: 700;
      color: var(--text-primary);
      display: block;
      line-height: 1.2;
    }

    .stat-number.gold { color: var(--accent-gold); }
    .stat-number.blue { color: var(--accent-blue); }
    .stat-number.teal { color: var(--accent-teal); }

    .stat-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
      margin-top: 0.4rem;
    }

    /* Section Headings */
    section {
      padding: 5.5rem 0;
      border-top: 1px solid var(--border);
    }

    .section-header {
      display: flex;
      align-items: baseline;
      gap: 1.25rem;
      margin-bottom: 3rem;
    }

    .section-num {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--accent-gold);
    }

    .section-header h2 {
      font-family: var(--font-serif);
      font-size: 2.6rem;
      font-weight: 400;
      color: var(--text-primary);
    }

    .section-header h2 em {
      font-style: italic;
      color: var(--accent-gold);
    }

    /* About Grid */
    .about-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 3rem;
    }

    .about-bio p {
      color: var(--text-secondary);
      font-size: 1.02rem;
      margin-bottom: 1.2rem;
    }

    .about-bio strong {
      color: var(--text-primary);
    }

    .about-meta {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .about-meta a {
      color: var(--accent-gold);
      text-decoration: none;
      font-weight: 600;
    }

    .pillars-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .pillar-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }

    .pillar-icon {
      font-size: 1.4rem;
      line-height: 1;
    }

    .pillar-title {
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--text-primary);
      margin-bottom: 0.25rem;
    }

    .pillar-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.45;
    }

    /* Experience Timeline */
    .exp-list {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .exp-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 2rem;
    }

    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .exp-role {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .exp-company {
      font-size: 0.95rem;
      color: var(--accent-gold);
      font-weight: 600;
      margin-top: 0.2rem;
    }

    .exp-dates {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text-muted);
      background: var(--surface-card);
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      border: 1px solid var(--border);
    }

    .exp-bullets {
      margin-top: 1.2rem;
      padding-left: 1.2rem;
      color: var(--text-secondary);
      font-size: 0.93rem;
    }

    .exp-bullets li {
      margin-bottom: 0.55rem;
    }

    .exp-bullets strong {
      color: var(--text-primary);
    }

    /* Interactive Accordion Case Studies */
    .case-studies {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    .case-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color 0.2s ease;
    }

    .case-card.active {
      border-color: var(--accent-gold);
    }

    .case-header {
      padding: 1.8rem 2rem;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      user-select: none;
    }

    .case-meta {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent-gold);
      margin-bottom: 0.4rem;
    }

    .case-title {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .case-subtitle {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-top: 0.35rem;
    }

    .case-kpis {
      display: flex;
      gap: 1.5rem;
      text-align: right;
    }

    .case-kpi-item span:first-child {
      display: block;
      font-family: var(--font-mono);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.1;
    }

    .case-kpi-item span:last-child {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    .chevron {
      font-size: 1.2rem;
      color: var(--accent-gold);
      transition: transform 0.3s ease;
    }

    .case-card.active .chevron {
      transform: rotate(180deg);
    }

    .case-body {
      display: none;
      padding: 0 2rem 2.2rem;
      border-top: 1px solid var(--border);
      background: var(--surface-card);
    }

    .case-card.active .case-body {
      display: block;
    }

    .case-section-title {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      color: var(--accent-teal);
      letter-spacing: 0.08em;
      margin: 1.8rem 0 0.6rem;
      font-weight: 700;
    }

    .case-body p {
      color: var(--text-secondary);
      font-size: 0.94rem;
      margin-bottom: 0.85rem;
    }

    .case-body ul {
      padding-left: 1.2rem;
      color: var(--text-secondary);
      font-size: 0.93rem;
    }

    .case-body li {
      margin-bottom: 0.5rem;
    }

    .case-body strong {
      color: var(--text-primary);
    }

    /* Skills Grid */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
    }

    .skill-block {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem;
    }

    .skill-block-title {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--accent-gold);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 1rem;
      font-weight: 700;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.6rem;
    }

    .skill-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .skill-pill {
      font-size: 0.82rem;
      padding: 0.35rem 0.75rem;
      background: var(--surface-card);
      border: 1px solid var(--border);
      border-radius: 5px;
      color: var(--text-secondary);
    }

    /* Certifications & Education */
    .grid-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .cert-item {
      padding: 1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 0.75rem;
    }

    .cert-name {
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--text-primary);
    }

    .cert-issuer {
      font-size: 0.8rem;
      color: var(--accent-gold);
      margin-top: 0.2rem;
    }

    /* Contact Section */
    .contact-banner {
      background: linear-gradient(135deg, var(--surface) 0%, #171b26 100%);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 3.5rem 2.5rem;
      text-align: center;
    }

    .contact-banner h2 {
      font-family: var(--font-serif);
      font-size: 2.8rem;
      font-weight: 400;
      margin-bottom: 1rem;
    }

    .contact-banner h2 em {
      font-style: italic;
      color: var(--accent-gold);
    }

    .contact-banner p {
      color: var(--text-secondary);
      max-width: 620px;
      margin: 0 auto 2rem;
      font-size: 1.05rem;
    }

    .contact-links {
      display: flex;
      justify-content: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.8rem 1.6rem;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-primary {
      background: var(--accent-gold);
      color: #0c0e12;
    }

    .btn-primary:hover {
      background: #f0c57c;
      transform: translateY(-2px);
    }

    .btn-secondary {
      background: var(--surface-card);
      color: var(--text-primary);
      border: 1px solid var(--border-accent);
    }

    .btn-secondary:hover {
      border-color: var(--accent-gold);
      color: var(--accent-gold);
      transform: translateY(-2px);
    }

    footer {
      padding: 2.5rem 0;
      text-align: center;
      font-size: 0.82rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
    }

    @media (max-width: 868px) {
      nav ul { display: none; }
      .about-grid, .grid-2col { grid-template-columns: 1fr; }
      .case-header { flex-direction: column; align-items: flex-start; }
      .case-kpis { text-align: left; }
    }
  </style>
</head>
